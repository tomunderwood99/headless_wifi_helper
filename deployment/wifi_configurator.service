[Unit]
Description=WiFi Captive Portal Configurator
# Wait for NetworkManager to be ready so nmcli works, but run BEFORE
# network-online.target is declared reached. That way downstream services
# which depend on network-online.target wait until either WiFi is up or the
# user has reconfigured it via the portal.
After=NetworkManager.service
Wants=NetworkManager.service
Before=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/pi/headless_wifi_helper
# Optional: path to the .env file an API key should be written to.
# When omitted, falls back to /home/pi/.env. See README → Configuration.
# Or: sudo ./deployment/setup.sh --env-file /home/pi/myproject/.env
# Environment="ENV_FILE_PATH=/home/pi/myproject/.env"
#
# Optional: variable name written into .env when the user pastes a key (default: API_KEY in code).
# Or: sudo ./deployment/setup.sh --env-key-name MBTA_API_KEY
# Environment="ENV_KEY_NAME=MBTA_API_KEY"
#
# Hotspot SSID/password used when no WiFi is reachable.
# setup.sh will overwrite AP_PASSWORD with either your --ap-password value or
# an autogenerated 16-char random one. The runtime refuses to start if
# AP_PASSWORD is left as the literal default below, so do not leave it as-is
# when hand-editing this file: pick something at least 12 characters long.
Environment=AP_SSID=PiWifiSetup
Environment=AP_PASSWORD=setupwifi
# Uncomment if `nmcli device wifi hotspot` fails on Pi (regulatory / hostapd):
# Environment=WIFI_REGDOMAIN=US
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/headless_wifi_helper/venv/bin/python wifi_configurator.py
# Don't restart on failure: if the portal crashes mid-flow, an automatic
# restart would yank the AP out from under the user. Boot will retry on
# the next reboot.
Restart=no
TimeoutStartSec=0

[Install]
WantedBy=network-online.target
